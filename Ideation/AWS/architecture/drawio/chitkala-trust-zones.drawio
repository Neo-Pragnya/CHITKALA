<mxfile host="archlib"><diagram name="Trust zones, local and cloud — authority lives in grants, not in text"><mxGraphModel dx="1566" dy="718" grid="1" gridSize="10" page="1" pageWidth="1566" pageHeight="718"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n_z3" value="Zone 3 · Untrusted content" style="swimlane;startSize=26;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#B4322A;fontColor=#FFFFFF;strokeColor=#B4322A;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="129" y="195" width="318.0" height="90" as="geometry"/></mxCell><mxCell id="nb_z3" value="imported Markdown / HTML / MDX&lt;br&gt;web captures, repository files&lt;br&gt;treated as data, never instructions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="n_z3"><mxGeometry x="0" y="26" width="318" height="64" as="geometry"/></mxCell><mxCell id="n_z4" value="Zone 4 · Untrusted extensions" style="swimlane;startSize=26;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#B4322A;fontColor=#FFFFFF;strokeColor=#B4322A;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="129" y="421" width="318.0" height="74" as="geometry"/></mxCell><mxCell id="nb_z4" value="skills, plugins, MCP servers&lt;br&gt;signed manifests, scoped grants" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="n_z4"><mxGeometry x="0" y="26" width="318" height="48" as="geometry"/></mxCell><mxCell id="n_z1" value="Zones 1–2 · Trusted core + UI" style="swimlane;startSize=26;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#3B48CC;fontColor=#FFFFFF;strokeColor=#3B48CC;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="633" y="304" width="351.6" height="90" as="geometry"/></mxCell><mxCell id="nb_z1" value="Rust core: files, keychain, policy broker&lt;br&gt;at